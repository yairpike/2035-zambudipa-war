; Engine configuration file.
config_version=5

[application]
config/name="ASEAN 2031"
run/main_scene="res://game/boot.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.0706, 0.0784, 0.0941, 1)
boot_splash/image="res://brand/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/icon="res://icon.png"
config/windows_native_icon="res://brand/icon.ico"
config/macos_native_icon="res://brand/icon.icns"

[autoload]

SMTouch="*res://addons/rts_advanced/sm_touch.gd"
SMWeb="*res://addons/rts_advanced/sm_web.gd"
RenderBudget="*res://game/render_budget.gd"
PerfProbe="*res://game/perf_probe.gd"

[debug]
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0

[gui]
theme/custom="res://assets/theme/game_theme.tres"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[internationalization]
locale/translations=PackedStringArray("res://localization/demo.en.translation", "res://localization/demo.fr.translation")

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
shading/overrides/force_lambert_over_burley=true
lights_and_shadows/directional_shadow/size=512
